{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CommsAtlas": {
    "DataPath": "data",
    "BackupsToKeep": 14,
    "Client": {
      "name": "CommsAtlas",
      "startWith": "blank",
      "server": "auto",
      "map": {
        "tiles": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        "attribution": "© OpenStreetMap contributors",
        "maxZoom": 19,
        "geocoder": "https://nominatim.openstreetmap.org/search",
        "center": [ -37.81, 144.96 ],
        "zoom": 7
      },
      "sso": null
    }
  }
}
